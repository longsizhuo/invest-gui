# invest-gui 环境变量示例
# 把本文件 cp 成 .env 后修改

# 实例名（footer 显示）—— fork 部署时改成自己的实例名，
# 比如 "Loong 的投资面板"、"Acme 投委会"。不设则显示 "openInvest"。
# 注：Vite 的 import.meta.env 只读 VITE_ 前缀的变量。
VITE_INSTANCE_NAME=openInvest

# GitHub 仓库 URL（footer 链接）—— fork 时改成自己的仓库地址
VITE_GITHUB_REPO=https://github.com/longsizhuo/openInvest

# 后端 API 地址（dev 用，生产 Caddy 同源反代时不需要）
# VITE_API_BASE=http://127.0.0.1:8765
